# Frozen research definitions under config/ are hashed by
# config/frozen_manifest_v1.json. Disable end-of-line conversion for them so a
# checkout on a platform that would otherwise rewrite CRLF (a Windows runner
# with core.autocrlf) leaves their bytes exactly as committed. The hash contract
# also normalises line endings before hashing, so this is belt and braces: the
# manifest should fire on content, never on the platform that checked it out.
config/*.json -text

# Recorded evidence and captured JSON lines are hashed and compared elsewhere in
# the repository; leave their bytes alone too.
*.jsonl -text

# Hash-bound D4 formal-review snapshots must remain byte-identical.
research/volatility_state_d4/review_snapshot_*.json -text

# Audited public Spot CSV hashes bind the exact collector bytes, including EOLs.
artifacts/public_spot_8h_20261010/aligned_csv/*.csv -text whitespace=cr-at-eol
artifacts/public_kucoin_8h_20261010/raw/*.json -text
artifacts/public_kucoin_8h_20261010/aligned_csv/*.csv -text
# PSR4 output manifest binds the exact generated CSV/JSON bytes across platforms.
artifacts/public_btc_relative_state_20261010/* -text whitespace=cr-at-eol
artifacts/public_research_extensions_20261010/** -text whitespace=cr-at-eol
