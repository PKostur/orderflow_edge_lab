{
  "schema_version": 1,
  "protocol_name": "btc-lead-lag-v1-state-first",
  "frozen_at_intent": "2026-09-14",
  "outcomes_inspected_before_freeze": false,
  "status": "development_screening",
  "purpose": "Test whether lagged BTC impulses predict subsequent altcoin residual direction before evaluating any executable strategy economics.",
  "lineage": {
