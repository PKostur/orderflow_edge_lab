{
  "schema_version": 1,
  "agents": [
    {
      "id": "data_integrity",
      "focus": "Market-data adapters, DeepCharts/dxFeed and MEXC ingestion, sequence integrity, timestamps, provenance, and causal feature eligibility",
      "required_paths": [
        "src/orderflow_edge_lab/adapters.py",
        "src/orderflow_edge_lab/data_lineage.py",
        "src/orderflow_edge_lab/dxfeed_bbo.py",
        "src/orderflow_edge_lab/mexc_orderflow.py"
      ],
      "forbidden_claims": []
    },
    {
      "id": "research_validity",
      "focus": "Discovery/validation/holdout separation, frozen discovery protocols, candidate freezing, trial accounting, causal audits, realistic economics, and promotion evidence",
      "required_paths": [
        "config/orderflow_discovery_v1.json",
        "src/orderflow_edge_lab/discovery_aggregate.py",
        "src/orderflow_edge_lab/research_protocol.py",
        "src/orderflow_edge_lab/candidate_freeze.py",
        "src/orderflow_edge_lab/holdout_audit.py",
        "src/orderflow_edge_lab/trial_ledger.py",
        "src/orderflow_edge_lab/promotion.py"
      ],
      "forbidden_claims": ["guaranteed profitable", "proven profitable edge"]
    },
    {
      "id": "strategy_validation",
      "focus": "Order-flow screening, backtest assumptions, costs, ambiguous fills, walk-forward/OOS evidence, overfitting controls, and candidate comparison",
      "required_paths": [
        "src/orderflow_edge_lab/orderflow_backtest.py",
        "src/orderflow_edge_lab/discovery_aggregate.py",
        "src/orderflow_edge_lab/economics.py",
        "src/orderflow_edge_lab/validation.py"
      ],
      "forbidden_claims": ["risk free", "guaranteed return"]
    },
    {
      "id": "execution_safety",
      "focus": "Approval-bound paper execution, risk checks, stale-market rejection, state ownership, journal integrity, kill switches, and reconciliation",
      "required_paths": [
        "src/orderflow_edge_lab/approval.py",
        "src/orderflow_edge_lab/execution.py",
        "src/orderflow_edge_lab/runtime_snapshot.py",
        "src/orderflow_edge_lab/session_audit.py"
      ],
      "forbidden_claims": []
    },
    {
      "id": "reliability_ci",
      "focus": "Compilation, unit/integration tests, packaging, installed command smoke tests, scheduled research workflows, and cross-platform CI readiness",
      "required_paths": [
        ".github/workflows/ci.yml",
        ".github/workflows/orderflow-continuous-discovery.yml",
        "scripts/deployment_check.py",
        "scripts/package_smoke.py"
      ],
      "forbidden_claims": []
    },
    {
      "id": "observability_deployment",
      "focus": "Structured reports, hashes, manifests, logs, run identity, reproducibility, operator diagnostics, and deployment documentation",
      "required_paths": [
        "docs/DEPLOYMENT.md",
        "docs/RESEARCH_PROTOCOL.md",
        "docs/ORDERFLOW_BACKTEST.md",
        "src/orderflow_edge_lab/runtime_identity.py"
      ],
      "forbidden_claims": []
    },
    {
      "id": "adversarial_reviewer",
      "focus": "Challenge cross-agent conclusions, detect unsupported edge claims, hidden holdout reuse, threshold tuning from scheduled discovery batches, unsafe live-execution creep, and fail-open behavior",
      "required_paths": [
        "README.md"
      ],
      "forbidden_claims": ["guaranteed profitable", "risk free", "certain profit", "proven profitable edge"]
    }
  ],
  "release_manager": {
    "block_on": ["critical", "error"],
    "require_agents": [
      "data_integrity",
      "research_validity",
      "strategy_validation",
      "execution_safety",
      "reliability_ci",
      "observability_deployment",
      "adversarial_reviewer"
    ],
    "live_order_transmission_supported": false,
    "profitable_edge_established": false
  }
}
