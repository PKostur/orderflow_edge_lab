{
  "schema_version": 1,
  "protocol_name": "gold_macro_shock_event_v1",
  "evidence_class": "post_observation_retrospective_development_with_locked_validation_not_future_oos",
  "motivation": "Gold/silver relative-value research repeatedly produced state information but no robust executable edge. This protocol changes return source and traded object: it tests whether exogenous daily macro shocks predict short-horizon XAUUSD continuation or reversal.",
  "source": {
    "gold_repository": "simom1/XAUUSD-history",
    "gold_commit": "bda79c6c5ce09a5b488d4cd2c20fcd19bdd2ed3a",
    "gold_path": "Gold-Cash/XAUUSD/XAUUSD_D1_2010_2026.csv",
    "macro_provider": "FRED",
    "macro_series": {
      "VIXCLS": "CBOE Volatility Index: VIX",
      "DTWEXBGS": "Nominal Broad U.S. Dollar Index",
      "DFII10": "10-Year Treasury Inflation-Indexed Constant Maturity Rate"
    }
  },
  "data_admission": {
    "weekdays_only": true,
    "minimum_tick_volume": 2,
    "positive_ohlc_required": true,
    "macro_observation_lag_trading_bars": 1,
    "macro_asof_forward_fill_max_calendar_days": 5,
    "no_backfill": true,
    "no_interpolation": true
  },
  "periods": {
    "development": {"start": "2010-01-01", "end_exclusive": "2021-01-01"},
    "locked_internal_validation": {"start": "2021-01-01", "end_exclusive": "2024-01-01", "opened_during_development": false},
    "retrospective_extension": {"start": "2024-01-01", "end_exclusive": "2026-09-15", "opened_during_development": false},
    "future_shadow_earliest_utc": "2026-09-16T00:00:00Z"
  },
  "shock_model": {
    "change_definition": {
      "vix": "one-bar log return",
      "usd": "one-bar log return",
      "real_yield": "one-bar arithmetic change in percentage points"
    },
    "standardization_window_trading_bars": 63,
    "standardization_min_periods": 63,
    "component_signs_for_gold_positive_shock": {
      "vix": 1.0,
      "usd": -1.0,
      "real_yield": -1.0
    },
    "composite": "(z_vix - z_usd - z_real_yield) / sqrt(3)",
    "event_abs_composite_gte": [1.5, 2.0]
  },
  "state_first": {
    "modes": ["continuation", "reversal"],
    "forward_horizons_trading_bars": [5, 10],
    "unique_hypotheses": 8,
    "predictor": "continuation uses signed composite; reversal uses negative signed composite",
    "target": "future uncosted XAUUSD close-to-close return over the frozen horizon",
    "dependence_cluster_calendar_days": 126,
    "minimum_events_per_state_fold": 6,
    "minimum_scorable_state_folds": 10,
    "minimum_median_fold_spearman": 0.0,
    "minimum_positive_state_fold_fraction": 0.60,
    "sign_flip_epochs": 20000,
    "sign_flip_seed": 20260915,
    "maximum_bh_fdr_q": 0.10
  },
  "execution": {
    "signal_time": "completed daily close using macro values lagged by one XAU trading bar",
    "entry": "next XAUUSD daily open",
    "exit": "XAUUSD daily open after frozen horizon",
    "same_bar_fill": false,
    "one_active_trade": true,
    "round_trip_cost_bps": [2.5, 5.0, 10.0],
    "primary_cost_bps": 5.0,
    "high_cost_bps": 10.0
  },
  "economic_gate": {
    "minimum_non_overlapping_trades": 45,
    "minimum_primary_median_fold_net_bps": 0.0,
    "minimum_primary_median_fold_pf": 1.10,
    "minimum_primary_positive_fold_fraction": 0.60,
    "minimum_high_cost_median_fold_net_bps": 0.0,
    "minimum_overall_mean_primary_net_bps": 0.0,
    "require_original_mean_gt_reversed_mean": true,
    "require_primary_median_fold_risk_adjusted_gt_equal_timing_long_gold": true,
    "minimum_long_trades": 12,
    "minimum_short_trades": 12,
    "require_positive_mean_primary_net_both_directions": true
  },
  "controls": {
    "reversed_direction": true,
    "equal_timing_long_gold": true,
    "report_long_and_short_subsets": true,
    "report_component_state_correlations_diagnostic_only": true
  },
  "candidate_selection": {
    "maximum_candidates": 2,
    "locked_validation_may_open_only_after_separate_candidate_freeze_commit": true
  },
  "claims": {
    "verified_future_oos": false,
    "profitable_edge_established": false,
    "leverage_authorized": false,
    "live_enabled": false
  }
}
