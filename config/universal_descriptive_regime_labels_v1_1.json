  "supersedes_inference_only": "universal-descriptive-regime-labels-v1",
  "implementation_freeze_commit": null,
  "reason_for_new_version": "The first frozen v1 artifact exposed an inference implementation defect: sparse cells, including one-trade cells, could receive spuriously tiny bootstrap p-values because resampling did not impose the zero-expectancy null. v1.1 preserves every v1 label, trade attribution rule, strategy, cost, cell and descriptive metric while replacing only the hypothesis-test layer.",
  "inherits": {
    "label_protocol": "universal-descriptive-regime-labels-v1",
    "label_implementation_freeze_commit": "f481ae50fee98953a6542334d10c123870e6301d",
    "v1_joint_cell_count": 162,
    "v1_artifact_digest": "sha256:13f9ae3e420067c1b8b81cfd5e3c17e02fcc9fd31404274a8bda0d0b9969bfd8",
    "v1_joint_cell_set_sha256": "2bb7f94fb7ce3dbc65748d98cb726ee9c8072fae31319fbd073f9d935c3b46cc"
  },
  "frozen_v1_label_contract": {
    "timeframe": "8h",
    "primary_cost_bps": 20,
    "labels": {
      "trend_efficiency": {
        "method": "kaufman_efficiency_ratio_absolute_net_close_change_over_total_absolute_close_path",
        "window_bars": 42,
        "percentile_history_bars": 540,
        "lower_quantile": 0.3333333333333333,
        "upper_quantile": 0.6666666666666666,
        "persistence_bars": 3,
        "states": [
          "CHOP",
          "MIXED",
          "TREND"
        ],
        "threshold_history_excludes_current_feature_bar": true
      },
      "volatility": {
        "method": "garman_klass_ohlc_volatility",
        "window_bars": 21,
        "percentile_history_bars": 540,
        "lower_quantile": 0.3333333333333333,
        "upper_quantile": 0.6666666666666666,
        "persistence_bars": 3,
        "states": [
          "LOW",
          "MID",
          "HIGH"
        ],
        "threshold_history_excludes_current_feature_bar": true,
        "annualization": "none"
      },
      "market_coupling": {
        "method": "average_pairwise_pearson_correlation_of_close_to_close_log_returns",
        "window_bars": 90,
        "minimum_pair_count": 10,
        "percentile_history_bars": 540,
        "lower_quantile": 0.3333333333333333,
        "upper_quantile": 0.6666666666666666,
        "persistence_bars": 3,
        "states": [
          "LOW",
          "MID",
          "HIGH"
        ],
        "threshold_history_excludes_current_feature_bar": true,
        "same_global_coupling_state_applies_to_all_symbols_at_timestamp": true
      },
      "shock": {
        "method": "absolute_one_bar_log_return_vs_trailing_sigma",
        "sigma_history_bars": 540,
        "sigma_threshold": 4,
        "active_bars_including_event": 10,
        "states": [
          "NORMAL",
          "SHOCK"
        ],
        "sigma_history_excludes_current_return": true,
        "persistence_exception": "A shock becomes active immediately at the completed event bar and remains active for that bar plus the next nine completed bars; it is not delayed by the three-bar bucket switch rule."
      },
      "drawdown": {
        "method": "close_distance_from_trailing_540bar_intrabar_high",
        "lookback_bars": 540,
        "near_high_threshold": -0.1,
        "deep_drawdown_threshold": -0.2,
        "persistence_bars": 3,
        "states": [
          "NEAR_HIGH",
          "CORRECTION",
          "DEEP_DRAWDOWN"
        ],
        "threshold_rationale": "Fixed 10% and 20% drawdown bands are conventional descriptive market-loss thresholds. They are not calibrated to strategy PnL and are not claimed to transfer directly from equities to crypto."
      }
    },
    "attribution": {
      "trade_entry_uses_latest_completed_bar_strictly_before_entry": true,
      "no_current_entry_bar_high_low_close_used": true,
      "unknown_state_trades_are_retained_and_reported_but_excluded_from_substantive_joint_cells": true
    },
    "joint_cell_grid": {
      "trend_states": [
        "CHOP",
        "MIXED",
        "TREND"
      ],
      "volatility_states": [
        "LOW",
        "MID",
        "HIGH"
      ],
      "coupling_states": [
        "LOW",
        "MID",
        "HIGH"
      ],
      "shock_states": [
