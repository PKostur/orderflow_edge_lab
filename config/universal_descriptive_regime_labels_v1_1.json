        "SHOCK"
      ],
      "drawdown_states": [
        "NEAR_HIGH",
        "CORRECTION",
        "DEEP_DRAWDOWN"
      ],
      "emit_all_cartesian_cells_including_empty": true,
      "expected_joint_cells_per_strategy": 162
