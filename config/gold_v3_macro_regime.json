{
  "schema_version": 1,
  "protocol_name": "gold-v3-macro-regime",
  "frozen_at_intent": "2026-09-14",
  "status": "development_with_strategy_specific_internal_validation_reserved",
  "data": {
    "gold": "XAUUSD D1 public archive",
    "macro_official_sources": {
      "real_yield_10y": "FRED DFII10",
      "nominal_yield_10y": "FRED DGS10",
      "broad_usd": "FRED DTWEXBGS"
    },
    "development_start": "2010-01-01",
    "development_end_exclusive": "2024-01-01",
    "strategy_specific_validation_start": "2024-01-01",
    "strategy_specific_validation_end_exclusive": "2026-01-01",
    "validation_is_not_globally_untouched": true,
    "macro_values_lagged_one_completed_business_day": true,
    "missing_macro_values_forward_filled_only_after_their_original_observation_date": true
  },
  "economics": {
    "round_trip_cost_bps": [2.0,5.0,10.0],
    "primary_cost_bps": 5.0,
    "entry": "next XAUUSD D1 open after completed signal bar",
    "same_bar_fill_forbidden": true,
    "one_active_trade_per_cell": true
  },
  "dependence": {
    "calendar_fold_days": 126,
    "minimum_state_folds": 12,
    "minimum_total_trades": 50,
    "minimum_positive_fold_fraction": 0.60,
    "no_trade_crosses_fold_boundary": true
  },
  "features": {
    "real_yield_change": {"lookback_business_days":[5,20,60],"direction":"gold inverse to real-yield impulse"},
    "broad_usd_change": {"lookback_business_days":[5,20,60],"direction":"gold inverse to broad-dollar impulse"},
    "breakeven_change": {"definition":"DGS10 minus DFII10","lookback_business_days":[5,20,60],"direction":"gold same direction as breakeven-inflation impulse"},
    "combined_real_yield_usd": {"lookback_business_days":[5,20,60],"definition":"negative equal-weight z-scored real-yield and broad-dollar impulses"},
    "real_yield_usd_agreement": {"lookback_business_days":[5,20,60],"definition":"long only when both lagged real-yield and broad-dollar impulses are negative; short only when both are positive"}
  },
  "grid": {
    "continuous_feature_entry_abs_z": [0.5,1.0,1.5],
    "normalization_window_business_days": 252,
    "hold_trading_days": [5,20,60]
  },
  "state_before_pnl": {
    "target": "future XAUUSD next-open-to-frozen-exit raw return before costs",
    "median_fold_spearman_gt": 0.0,
    "positive_state_fold_fraction_gte": 0.60
  },
  "development_gate": {
    "primary_median_fold_net_expectancy_bps_gt": 0.0,
    "primary_median_fold_profit_factor_gt": 1.0,
    "primary_positive_fold_fraction_gte": 0.60,
    "high_cost_median_expectancy_bps_gte": 0.0,
    "must_beat_reversed_direction_control": true,
    "parameter_neighborhood_stability_required": true
  },
  "selection": {
    "max_candidates_opened_on_strategy_specific_validation": 3,
    "candidate_freeze_before_validation": true,
    "no_retuning_after_validation_open": true,
    "leverage_forbidden_until_unlevered_validation_pass": true
  },
  "claims": {"verified_oos":false,"profitable_edge_established":false,"live_enabled":false}
}
