{
  "schema_version": 1,
  "protocol_name": "lsk-btc-aligned-30s-regime-router-v1",
  "status": "frozen_at_intent_before_router_pnl_review",
  "symbol": "LSK_USDT",
  "context_symbol": "BTC_USDT",
  "family": "aligned_btc",
  "horizon_ms": 30000,
  "fee_bps_round_trip": [4.0, 8.0],
  "additional_execution_stress_bps_round_trip": [0.0, 2.0, 4.0],
  "causal_baseline": {
    "type": "prior_signal_state_only",
    "minimum_prior_signals": 5,
    "maximum_prior_signals": 20,
    "notes": "Only state observations timestamped before the current signal may define the adaptive baseline. No realized strategy PnL is used."
  },
  "state_features": {
    "participation": [
      "rolling_trade_count_10s",
      "local_quote_updates_per_second_15s"
    ],
    "price_response": [
      "local_return_15s_bps",
      "local_range_15s_bps",
      "price_response_efficiency"
    ],
    "displacement": [
      "abs_return_to_spread_15s",
      "range_to_spread_15s"
    ],
    "liquidity": [
      "spread_bps",
      "spread_vs_prior_median"
    ],
    "signal_context": [
      "btc_flow_alignment",
      "signal_strength_multiple"
    ]
  },
  "derived_feature_definitions": {
    "price_response_efficiency": "abs(local_return_15s_bps) / max(signal_strength_multiple, 1e-9)",
    "spread_vs_prior_median": "spread_bps / median(prior eligible signal spread_bps)"
  },
  "router": {
    "common_gate": {
      "btc_flow_alignment": "aligned",
      "minimum_signal_strength_multiple": 1.0
    },
    "original": {
      "rolling_trade_count_10s": ">= prior median",
      "local_quote_updates_per_second_15s": ">= prior median",
      "local_range_15s_bps": ">= prior median",
      "price_response_efficiency": ">= prior median",
      "abs_return_to_spread_15s": "< prior 75th percentile",
      "spread_vs_prior_median": "<= 1.25"
    },
    "reversed": {
      "abs_return_to_spread_15s": ">= prior 75th percentile",
      "price_response_efficiency": "<= prior 25th percentile",
      "exhaustion_confirmation": "at least one of: trade count below prior median, quote-update rate below prior median, spread_vs_prior_median > 1.0"
    },
    "otherwise": "no_trade",
    "precedence": ["reversed", "original", "no_trade"]
  },
  "controls": [
    "always_original",
    "always_reversed",
    "unconditional_frozen_signal"
  ],
  "numeric_forward_screen": {
    "minimum_independent_clusters": 5,
    "minimum_profit_factor_after_cost": 1.2,
    "minimum_positive_cluster_fraction": 0.6,
    "maximum_single_cluster_profit_share": 0.4,
    "minimum_net_mean_bps": 0.0
  },
  "anti_overfit": {
    "known_capture_evaluation_is_exploratory_only": true,
    "thresholds_must_not_change_after_known_capture_review": true,
    "true_forward_test_starts_only_after_this_manifest_is_frozen": true,
    "failed_future_clusters_must_be_retained": true,
    "do_not_weaken_protocol_after_failure": true
  },
  "claims": {
    "profitable_edge_established": false,
    "verified_out_of_sample_evidence": false,
    "standalone_router_promotable": false,
    "live_order_transmission_supported": false
  }
}
