{
  "schema_version": 1,
  "protocol_name": "gold_silver_threshold_state_v6",
  "evidence_class": "post_observation_retrospective_state_research_with_locked_validation_not_future_oos",
  "motivation": "v5 found strong lower-tail convergence point estimates but did not pass its tail-depth/breadth gate. Threshold cointegration is fundamentally a conditional-state hypothesis: crossing a threshold may change average adjustment without requiring deeper tail observations to converge monotonically faster. v6 therefore tests tail-state convergence relative to a same-side non-tail baseline, with no PnL scoring.",
  "source": {
