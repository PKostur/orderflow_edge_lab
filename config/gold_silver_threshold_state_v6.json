    "commit": "bda79c6c5ce09a5b488d4cd2c20fcd19bdd2ed3a",
    "gold_path": "Gold-Cash/XAUUSD/XAUUSD_D1_2010_2026.csv",
    "silver_path": "Silver-Cash/XAGUSD/XAGUSD_D1.csv"
  },
  "data_admission": {
    "common_dates_only": true,
    "weekdays_only": true,
    "minimum_tick_volume_each_leg": 2,
    "positive_ohlc_required": true,
    "duplicate_policy": "keep_last",
    "no_interpolation": true
  },
  "periods": {
    "development": {"start": "2010-01-01", "end_exclusive": "2021-01-01"},
    "locked_internal_validation": {"start": "2021-01-01", "end_exclusive": "2024-01-01", "opened_during_v6": false},
    "retrospective_extension": {
      "start": "2024-01-01",
      "end_exclusive": "2026-09-15",
      "opened_during_v6": false,
      "claim_boundary": "Even if later opened, this period is retrospective and not future OOS because related gold/silver evidence from this era has already been inspected."
    },
    "future_shadow_earliest_utc": "2026-09-16T00:00:00Z"
  },
  "relationship_model": {
    "type": "rolling_ols_log_price_equilibrium",
    "lookback_trading_days": 252,
    "fit_uses_completed_bars_before_signal_only": true,
    "beta_gt": 0.05,
    "beta_lt": 3.0,
    "minimum_residual_std": 0.001
  },
  "tail_hypotheses": [
    {"name": "lower_q10", "side": "long_spread", "tail_quantile": 0.10},
    {"name": "lower_q20", "side": "long_spread", "tail_quantile": 0.20},
    {"name": "upper_q80", "side": "short_spread", "tail_quantile": 0.80},
    {"name": "upper_q90", "side": "short_spread", "tail_quantile": 0.90}
  ],
  "state_target": {
    "horizon_trading_bars": 21,
    "definition": "side-adjusted frozen-equilibrium residual convergence over 21 trading bars, normalized by signal-time residual standard deviation",
    "tail_effect": "within each dependence fold, median target in the tail minus median target for same-side non-tail residual states"
  },
  "state_first": {
    "unique_hypotheses": 4,
    "dependence_cluster_calendar_days": 252,
    "minimum_tail_events_per_fold": 8,
    "minimum_baseline_events_per_fold": 20,
    "minimum_scorable_folds": 10,
    "minimum_median_tail_effect": 0.0,
    "minimum_positive_tail_effect_fold_fraction": 0.65,
    "minimum_median_tail_target": 0.0,
    "minimum_positive_tail_target_fold_fraction": 0.60,
    "sign_flip_epochs": 20000,
