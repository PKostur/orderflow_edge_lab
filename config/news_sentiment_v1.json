  },
  "strategies": {
    "prospective_start_utc": "2026-11-01T00:00:00Z",
    "signal_timing": "positions held over day d use only items dated d-1 or earlier",
    "N1_news_momentum": "weekly (Mondays): among coins with >= 3 mentions in the last 7 days (need >= 6 such coins, else flat), long the 3 with the highest summed item score and short the 3 with the lowest, 0.5 gross per side",
    "N2_attention_breakout": "a coin enters on day d if its mentions over d-3..d-1 are >= 3 x its mean 3-day count over the prior 30 days and its mean score over d-3..d-1 is > 0; held 7 days; longs equal-weighted at 0.5 gross, hedged with a 0.5 gross short in the equal-weight basket; flat if none",
    "N3_market_tone_following": "equal-weight basket long when the 7-day mean market score is above its prior 30-day mean, short when below",
    "N4_news_panic_momentum_pause": "overlay: the multi-premia momentum leg S2 scaled by 0.5 on days when the 3-day mean market score is at or below the 10th percentile of its prior 60 days; compared with the unchanged blend",
    "economics": "20 bps round trip, MEXC funding on held weights, same data as multi-premia-blend-v1"
  },
  "review": {
    "descriptive_after_days": 90,
    "verdict_after_days": 180,
    "rule": "per book: mean > 0, Newey-West t >= 2 at 180 days for a standalone book; the overlay must raise the blend Sharpe and not deepen its drawdown; anything else is FAIL"
  },
  "claims": {
    "strategy_promotion_authorized": false,
    "paper_trading_authorized": false,
