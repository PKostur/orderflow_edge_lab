{
  "schema_version": 1,
  "protocol_name": "sentiment-monitor-v1.1",
  "status": "forward_observational",
  "frozen_at_utc": "2026-09-13T21:14:00Z",
  "evidence_start_utc": "2026-09-13T22:00:00Z",
  "purpose": "Collect deterministic public-headline sentiment for the already-frozen strategy universe as market-state research, without changing, filtering, reversing, sizing or timing any strategy trade.",
  "sources": [
    {
      "name": "coindesk",
      "url": "https://www.coindesk.com/arc/outboundfeeds/rss/",
      "access": "public_rss"
    },
    {
      "name": "decrypt",
      "url": "https://decrypt.co/feed",
      "access": "public_rss"
    }
  ],
  "observation_universe": {
    "strategy_conditioning_symbols": [
      "ETH_USDT",
      "SOL_USDT",
      "XRP_USDT",
      "DOGE_USDT",
      "BNB_USDT",
      "ADA_USDT",
      "LINK_USDT",
      "SUI_USDT",
      "ENA_USDT"
    ],
    "context_only_symbols": [
      "BTC_USDT"
    ],
    "readiness_symbols": [
      "ETH_USDT",
      "SOL_USDT",
      "XRP_USDT",
      "DOGE_USDT",
      "BNB_USDT",
      "ADA_USDT",
      "LINK_USDT",
      "SUI_USDT",
      "ENA_USDT"
    ],
    "source": "union of non-BTC symbols in config/htf_trend_candidate_v1.json plus config/ena_mean_reversion_candidate_v1.json",
    "strategy_pnl_used_for_universe_selection": false,
    "dynamic_cross_pair_panel_used_for_readiness": false,
    "btc_context_only_reason": "BTC-relative outcome is degenerate for BTC itself; BTC sentiment may be observed as context but does not count toward v1.1 readiness or authorize a BTC sentiment veto."
  },
  "matching": {
    "scope": "headline_or_title_only",
    "method": "conservative_symbol_aliases_from_news_monitor_v1",
    "article_bodies_stored": false,
    "credentials_or_account_data_stored": false
  },
  "scoring": {
    "method": "deterministic_phrase_lexicon_v1",
    "transform": "tanh(raw_score/3)",
    "score_range": [-1.0, 1.0],
    "neutral_abs_score_below": 0.1,
    "positive_phrase_weights": {
      "approved": 2.0,
      "approval": 1.5,
      "partnership": 1.25,
      "adoption": 1.25,
      "integration": 1.0,
      "upgrade": 0.75,
      "launch": 0.75,
      "inflows": 1.0,
      "record inflows": 1.5,
      "wins": 0.75,
      "expands": 0.75,
      "surge": 0.5,
      "rally": 0.5
    },
    "negative_phrase_weights": {
      "hack": -2.0,
      "exploit": -2.0,
      "breach": -2.0,
      "fraud": -2.0,
      "ban": -2.0,
      "lawsuit": -1.5,
      "charges": -1.5,
      "outflows": -1.0,
      "delist": -1.5,
      "delisted": -1.5,
      "outage": -1.5,
      "rejects": -1.5,
      "rejected": -1.5,
      "plunge": -0.75,
      "crash": -1.25,
      "liquidation": -0.75
    },
    "limitations": [
      "Headline sentiment is a deterministic lexical proxy, not semantic truth.",
      "Sarcasm, complex negation, ambiguous entity context and source framing can be missed.",
      "Phrase weights are frozen before forward v1.1 sentiment evidence and may not be tuned using strategy PnL."
    ]
  },
  "state_aggregation": {
    "feature_name": "decayed_headline_sentiment_v1_1",
    "method": "within_symbol_exponentially_decayed_weighted_mean",
    "half_life_minutes": 90,
    "maximum_age_hours": 6,
    "future_events_allowed": false,
    "strategy_pnl_may_tune_decay": false
  },
  "market_behavior": {
    "data_source": "MEXC public futures candlesticks",
    "interval": "Min5",
    "max_age_hours": 48,
    "pre_event_minutes": 15,
    "horizons_minutes": [5, 15, 30, 60],
    "context_symbol": "BTC_USDT",
    "relative_measure": "coin_return_minus_btc_return_bps_not_beta_adjusted"
  },
  "dependence": {
    "event_cluster_gap_minutes": 60,
    "same_or_near_publication_window_is_one_dependence_cluster": true,
    "same_time_cross_symbol_events_are_not_independent_time_trials": true
  },
  "state_targets_before_strategy_pnl": [
    "sentiment_sign_times_future_coin_minus_btc_return_bps",
    "future_absolute_coin_return_bps",
    "future_coin_minus_btc_return_bps"
  ],
  "state_readiness": {
    "minimum_scored_matched_events": 30,
    "minimum_non_neutral_events": 12,
    "minimum_independent_event_clusters": 5,
    "minimum_distinct_sources": 2,
    "minimum_distinct_conditioning_symbols": 4,
    "counts_only_readiness_symbols": true,
    "strategy_pnl_may_affect_readiness": false
  },
  "research_rules": [
    "Sentiment remains observational until the separately versioned conditioning protocol is both frozen and eligibility gates are satisfied.",
    "Do not infer causality from sentiment score and subsequent price behavior.",
    "Do not choose symbols, sources, phrases, phrase weights, thresholds, decay windows or horizons by strategy PF or expectancy.",
    "The v1.1 observation universe is fixed to the already-frozen strategy-conditioning symbols before v1.1 evidence starts.",
    "BTC is context-only for v1.1 readiness and cannot qualify a BTC sentiment veto under this protocol.",
    "Do not use sentiment to create a new entry, reverse a signal, increase size or alter stops during the observational stage.",
    "Incomplete future horizons remain incomplete rather than being imputed.",
    "Do not backfill v1 evidence into v1.1 and do not backfill missed v1.1 market time before evidence_start_utc."
  ],
  "claims": {
    "research_only": true,
    "observational_only": true,
    "causal_effect_established": false,
    "sentiment_is_strategy_filter": false,
    "eligible_as_strategy_filter": false,
    "v1_evidence_reused": false,
    "profitable_edge_established": false,
    "verified_out_of_sample_evidence": false,
    "live_order_transmission_supported": false
  },
  "supersedes": "sentiment-monitor-v1"
}
