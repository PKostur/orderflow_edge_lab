{
  "schema_version": 1,
  "protocol_name": "evolutionary-price-agent-v1",
  "status": "development_experiment",
  "purpose": "Evolve a raw-price trading agent without technical indicators, selecting descendants by profitability, win rate and cross-fold consistency while preserving a final untouched holdout.",
  "data": {
    "source": "MEXC public futures klines",
    "symbol": "ENA_USDT",
    "interval": "5m",
    "start": "2026-03-01",
    "discovery_end_exclusive": "2026-08-15",
    "holdout_end_exclusive": "2026-09-12"
  },
  "inputs": {
    "technical_indicators_allowed": false,
    "raw_fields": ["open", "high", "low", "close", "volume"],
    "derived_transformations": [
      "log close-to-close return",
      "open/high/low location relative to close",
      "log volume change"
    ],
    "maximum_lookback_bars": 24
  },
  "evolution": {
    "seed": 20260914,
    "population": 160,
    "generations": 80,
    "elite_fraction": 0.15,
    "random_survivor_fraction": 0.05,
    "mutation_scale": 0.20,
    "lookbacks": [4, 8, 12, 16, 24],
    "holding_period_bars": [1, 2, 3, 6, 12],
    "entry_threshold_range": [0.10, 2.50],
    "round_trip_cost_bps": 16.0,
    "minimum_trades_per_fold": 12,
    "fold_days": 14,
    "minimum_folds": 5,
    "fitness_weights": {
      "median_expectancy_bps": 1.0,
      "median_win_rate_above_half": 20.0,
      "median_profit_factor_above_one": 8.0,
      "positive_fold_fraction": 12.0,
      "drawdown_penalty": 10.0,
      "low_trade_penalty": 25.0
    }
  },
  "selection": {
    "selection_uses_discovery_period_only": true,
    "final_holdout_evaluated_once": true,
    "winner_requires_positive_median_fold_expectancy": true,
    "winner_requires_positive_fold_fraction": 0.60,
    "winner_requires_median_profit_factor": 1.10,
    "winner_requires_minimum_total_trades": 60,
    "winner_is_not_promotable_without_replication": true
  },
  "claims": {
    "profitable_edge_established": false,
    "verified_out_of_sample_evidence": false,
    "live_order_transmission_supported": false
  }
}
